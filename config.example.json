{
  "_comment": "MinimaxGuard 示例配置。复制为 config.json 并填入真实 token。注意 config.json 已被 .gitignore 排除，不会被提交。",
  "api_url": "https://www.minimaxi.com/v1/token_plan/remains",
  "poll_interval_seconds": 60,
  "request_timeout_seconds": 15,
  "data_file": "data/usage.ndjson",
  "history_limit": 50000,
  "keys": [
    {
      "alias": "primary",
      "token": "sk-cp-REPLACE-WITH-YOUR-ACTUAL-TOKEN",
      "tags": ["production"],
      "enabled": true
    },
    {
      "alias": "team",
      "token": "sk-cp-REPLACE-WITH-YOUR-ACTUAL-TOKEN",
      "tags": ["staging"],
      "enabled": true
    }
  ]
}
