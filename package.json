{
  "name": "minimax-guard",
  "version": "0.2.0",
  "description": "Minimax token plan monitor — Node.js + TypeScript + cross-platform desktop app (Pake)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "minimax-guard": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "node dist/index.js --server",
    "start:desktop": "node dist/index.js --desktop",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "package:mac": "npm run build && pake build --packager dmg --targets universal",
    "package:win": "npm run build && pake build --packager nsis --targets x64",
    "package:linux": "npm run build && pake build --packager deb --targets x64",
    "package:all": "npm run build && pake build --targets universal,x64"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "axios": "^1.7.7",
    "compression": "^1.7.4",
    "ws": "^8.18.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^22.7.5",
    "@types/express": "^4.17.21",
    "@types/compression": "^1.7.5",
    "@types/ws": "^8.5.12",
    "@types/cors": "^2.8.17"
  },
  "keywords": [
    "minimax",
    "monitor",
    "token-plan",
    "express",
    "typescript",
    "pake",
    "desktop"
  ],
  "license": "MIT"
}
